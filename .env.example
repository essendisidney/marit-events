# Production site URL (custom domain)
NEXT_PUBLIC_SITE_URL=https://maritevents.com

# Optional — server-side enquiry emails via Resend
# Get a key at https://resend.com — without it, form still works via WhatsApp/email handoff
RESEND_API_KEY=
# Verified sender after you add maritevents.com to Resend (fallback: onboarding@resend.dev)
RESEND_FROM_EMAIL=Marit Events <onboarding@resend.dev>
# Inbox that receives enquiries
ENQUIRE_TO_EMAIL=maritevents@gmail.com
