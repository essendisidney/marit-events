# Production site URL (custom domain)
NEXT_PUBLIC_SITE_URL=https://maritevents.com

# Optional — server-side enquiry emails via Resend
# Get a key at https://resend.com — without it, form still works via WhatsApp/email handoff
RESEND_API_KEY=
# Verified sender after you add maritevents.com to Resend (e.g. Marit Events <hello@maritevents.com>).
# Until the domain is verified, Resend only delivers to your Resend account email.
# Once verified: Rose gets a branded HTML enquiry; clients get an auto-reply.
RESEND_FROM_EMAIL=Marit Events <onboarding@resend.dev>
# Inbox that receives enquiries
ENQUIRE_TO_EMAIL=maritevents@gmail.com

# Optional — live availability check against Rose's Google Calendar on the enquiry form
# Create a Google Cloud service account with the Calendar API enabled, share Rose's
# calendar with the service account's email (view-only is enough), then set:
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key from the service account JSON key exactly as-is, including
# the BEGIN/END lines. Vercel handles the newlines fine when pasted directly.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# The calendar to check — usually Rose's Gmail address, once shared with the service account
GOOGLE_CALENDAR_ID=
